# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# A literal <password> placeholder in MONGODB_URI is replaced at runtime with
# MONGODB_PASSWORD (URL-encoded), so the secret stays out of the URI.
#
# Local:   mongodb://localhost:27017
# On-prem: mongodb://root:<password>@192.168.1.119:27017/
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://root:<password>@192.168.1.119:27017/
MONGODB_PASSWORD=
MONGODB_DB=Atal
# Residents, units, parking, visitors, maintenance and community.
MONGODB_USERS_DB=Atal_Users

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
# Avoid 4000: NoMachine's nxd service claims it on Windows.
PORT=8000
APP_ENV=development
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------
# Collection naming: <devicetype>_<index>_<granularity>, lower-cased.
# e.g. transformer_1_instant, transformer_1_monthly, transformer_1_yearly
# The first entry is the raw tier that rollups read from.
GRANULARITIES=instant,monthly,yearly
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000
